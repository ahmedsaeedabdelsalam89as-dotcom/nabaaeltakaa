<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="match_parent">
<TextView android:text="Naba Phone Bridge" android:textSize="24sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:id="@+id/status" android:text="غير مفعل" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/endpoint" android:textIsSelectable="true" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/secret" android:textIsSelectable="true" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/grantCall" android:text="السماح بالاتصال" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/startBridge" android:text="تشغيل الربط" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/rotateKey" android:text="تغيير مفتاح الربط" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>