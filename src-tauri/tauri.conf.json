{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Naba Fleet System",
  "version": "0.1.0",
  "identifier": "com.nabaaltaqah.fleet",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "نظام إدارة أسطول نبع الطاقة",
        "width": 1280,
        "height": 800,
        "minWidth": 360,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
